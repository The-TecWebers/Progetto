# Configurazione Database
# Copia questo file come .env e inserisci i valori corretti per il tuo ambiente.
#
# Per Docker (docker-compose):    i valori qui sotto vanno bene così come sono
# Per produzione (hosting):       sostituisci con le credenziali del server
# Per sviluppo locale (XAMPP etc): DB_HOST=localhost, DB_USER=root, DB_PASSWORD=, DB_NAME=EdilScavi

DB_HOST=db
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Credenziali MySQL (usate solo da docker-compose per creare il container)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=your_db_name
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
